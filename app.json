{
  "expo": {
    "name": "Duper",
    "slug": "duper-productivity",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/duper-logo.png",
    "scheme": "duper",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dhirajx.duper",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Duper needs access to your microphone to record voice notes.",
        "NSPhotoLibraryUsageDescription": "Duper needs access to your photos to let you update your profile picture.",
        "NSMotionUsageDescription": "Duper uses your motion data to track your daily steps.",
        "NSLocationWhenInUseUsageDescription": "Duper needs your location to show local weather and air quality."
      }
    },
    "android": {
      "package": "com.dhirajx.duper",
      "adaptiveIcon": {
        "backgroundColor": "#05080D",
        "foregroundImage": "./assets/images/duper-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/duper-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/duper-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#05080D",
          "dark": {
            "backgroundColor": "#05080D"
          }
        }
      ],
      "expo-notifications",
      "./plugins/with-full-screen-task-alarms",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PlannerTasks",
              "label": "Duper tasks",
              "description": "Today's tasks with quick completion and an Add action.",
              "minWidth": "210dp",
              "minHeight": "170dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PlannerMonth",
              "label": "Duper month",
              "description": "A monthly calendar with today highlighted and task markers.",
              "minWidth": "250dp",
              "minHeight": "245dp",
              "targetCellWidth": 5,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PlannerToday",
              "label": "Duper today",
              "description": "Today's date beside your upcoming tasks.",
              "minWidth": "280dp",
              "minHeight": "150dp",
              "targetCellWidth": 5,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Duper uses your calendar to sync planner tasks you choose."
        }
      ],
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Duper to use your location for weather updates."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Duper to track your steps."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Duper to record voice notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dcbf04f8-4759-4fc4-952f-5c1a756941e1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dcbf04f8-4759-4fc4-952f-5c1a756941e1"
    }
  }
}
